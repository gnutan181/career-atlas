# ── FastAPI ──────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Per bearer token (or IP before authentication), fixed-window API limit.
API_RATE_LIMIT_REQUESTS=30
API_RATE_LIMIT_WINDOW_SECONDS=60

# ── Supabase (Dashboard → Project Settings → API) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ── Auth ─────────────────────────────────────────────────
# true  → skip JWT verification, run every request as DEV_USER_ID
# false → require a real Supabase (Google) login
DEV_BYPASS_AUTH=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ── LLMs ─────────────────────────────────────────────────
# Groq powers resume parsing, gap analysis, roadmap/deep research, and the judge.
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini is used only for embeddings (Pinecone semantic retrieval). Support rotation with _1, _2, etc.
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=

# ── Web search ───────────────────────────────────────────
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# ── Gap analysis: Pinecone vector search + Jina rerank ───
JINA_API_KEY=YOUR_JINA_API_KEY_HERE
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE
PINECONE_INDEX_NAME=careeratlas
PINECONE_REGION=us-east-1
PINECONE_HOST=YOUR_PINECONE_HOST_URL_HERE

# ── Job search: Adzuna ───────────────────────────────────
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY

# ── Monitoring ───────────────────────────────────────────
# Sentry error tracking — leave blank to disable.
SENTRY_DSN=
# LangSmith LLM/agent tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_PROJECT=careeratlas-prod

# GitHub OAuth App
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── LLM provider routing ─────────────────────────────────
# default = existing Gemini/Groq split; azure = every LLM call goes to an
# Azure AI Foundry deployment; groq / gemini force a single provider.
LLM_PROVIDER=default
# Foundry OpenAI-compatible v1 endpoint, e.g. https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
AZURE_AI_TIMEOUT_SECONDS=60

# ── Guardrails: PII masking (Microsoft Presidio) ─────────
# presidio | regex (regex = previous email/phone-only masking)
PII_ENGINE=presidio
# Never add LOCATION, ORGANIZATION, DATE_TIME or NRP: extraction needs them.
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,STREET_ADDRESS,IN_PAN,IN_AADHAAR,IN_PASSPORT,IN_VOTER
PII_SCORE_THRESHOLD=0.5
PRESIDIO_SPACY_MODEL=en_core_web_lg

# ── Guardrails: Azure AI Content Safety Prompt Shields ───
PROMPT_SHIELDS_ENABLED=false
# e.g. https://<resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
PROMPT_SHIELDS_TIMEOUT_SECONDS=10

# ── Guardrails: output validation (Guardrails AI) ────────
OUTPUT_GUARDS_ENABLED=true
# Needs `guardrails-ai-toxic-language` (torch + local BERT model) installed.
TOXICITY_GUARD_ENABLED=false
